{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConvertMe Image",
  "version": "0.1.1",
  "identifier": "app.convertme.image",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ConvertMe Image",
        "width": 920,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Convert and resize images locally",
    "longDescription": "Convert still images between PNG, JPEG, WebP, BMP, GIF, and TIFF. Resize and rotate images locally on your Windows PC.",
    "copyright": "ConvertMe Image contributors",
    "resources": {
      "LICENSE": "LICENSE",
      "THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerHooks": "packaging/windows-hooks.nsh"
      },
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "skip" }
    }
  }
}
