# Converting the tree

* text=auto eol=lf

# Reproducible fixtures and pinned tool archives must not be re-encoded by git.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.onnx binary
*.zst binary
*.tar.gz binary
*.zip binary
*.deb binary
*.rpm binary
*.exe binary
*.dll binary
*.AppImage binary

# Lockfile and generated manifests stay diffable, but are regenerated by tooling.
Cargo.lock linguist-generated=true
ui/package-lock.json linguist-generated=true
